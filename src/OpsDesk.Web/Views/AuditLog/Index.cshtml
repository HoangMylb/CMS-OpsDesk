@model OpsDesk.Web.ViewModels.AuditLog.AuditLogListViewModel
@{
    ViewData["Title"] = "Audit Log";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold py-1 mb-0">System Audit Trail</h4>
        <p class="text-muted mb-0">Immutable compliance log recording system mutations, data changes, and user activities.</p>
    </div>
    <span class="badge bg-label-secondary d-flex align-items-center py-2 px-3">
        <i class="bx bx-lock-alt me-1 fs-5"></i>Append-only Immutable Log
    </span>
</div>

<!-- Search & Filter Card -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end" data-ajax-form data-ajax-target="auditlog-table-container">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Action Pattern</label>
                <div class="input-group input-group-merge">
                    <span class="input-group-text"><i class="bx bx-tag"></i></span>
                    <input type="search" name="action" value="@Model.Action" class="form-control" 
                           placeholder="TicketCreated, RoleUpdated..." autocomplete="off" />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold">Entity Domain</label>
                <select name="entityName" class="form-select">
                    <option value="">-- All Entities --</option>
                    <option value="Ticket" selected="@(Model.EntityName == "Ticket")">Ticket</option>
                    <option value="TicketMessage" selected="@(Model.EntityName == "TicketMessage")">TicketMessage</option>
                    <option value="Customer" selected="@(Model.EntityName == "Customer")">Customer</option>
                    <option value="ApplicationUser" selected="@(Model.EntityName == "ApplicationUser")">ApplicationUser</option>
                    <option value="IdentityRole" selected="@(Model.EntityName == "IdentityRole")">IdentityRole</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold">From Date</label>
                <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold">To Date</label>
                <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1 d-flex align-items-center justify-content-center">
                    <i class="bx bx-filter-alt me-1"></i>Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" title="Reset">
                    <i class="bx bx-reset"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div id="auditlog-table-container">
    <partial name="_AuditLogTable" model="Model" />
</div>


<!-- Modal: Audit JSON Detail -->
<div class="modal fade" id="auditDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow">
            <div class="modal-header border-bottom">
                <div class="d-flex align-items-center">
                    <span class="badge bg-label-primary p-2 rounded me-2">
                        <i class="bx bx-code-block fs-5"></i>
                    </span>
                    <div>
                        <h5 class="modal-title fw-bold" id="auditModalTitle">Mutation Payload</h5>
                        <small class="text-muted" id="auditModalSubtitle"></small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="auditModalBody">
                <!-- Injected via JavaScript -->
            </div>
            <div class="modal-footer border-top py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showAuditModal(action, entity, id, oldVal, newVal) {
            document.getElementById('auditModalTitle').textContent = `Action: ${action}`;
            document.getElementById('auditModalSubtitle').textContent = `Target: ${entity} (ID: #${id})`;

            function formatJson(str) {
                if (!str) return '';
                try {
                    return JSON.stringify(JSON.parse(str), null, 2);
                } catch {
                    return str;
                }
            }

            let html = '';
            if (oldVal) {
                html += `
                    <div class="mb-3">
                        <h6 class="fw-bold text-muted small text-uppercase">Previous Values:</h6>
                        <pre class="bg-lighter p-3 rounded border border-light font-monospace small" style="max-height: 250px; overflow-y: auto;">${escapeHtml(formatJson(oldVal))}</pre>
                    </div>
                `;
            }
            if (newVal) {
                html += `
                    <div class="mb-0">
                        <h6 class="fw-bold text-primary small text-uppercase">Updated / Current Values:</h6>
                        <pre class="bg-lighter p-3 rounded border border-light font-monospace small" style="max-height: 250px; overflow-y: auto;">${escapeHtml(formatJson(newVal))}</pre>
                    </div>
                `;
            }

            document.getElementById('auditModalBody').innerHTML = html || '<p class="text-muted text-center mb-0">No payload available.</p>';
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('auditDetailModal'));
            modal.show();
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
}
