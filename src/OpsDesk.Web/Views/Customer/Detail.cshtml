@model OpsDesk.Web.ViewModels.Customer.CustomerDetailViewModel
@using OpsDesk.Core.Enums
@{
    ViewData["Title"] = $"Customer: {Model.Customer.Name}";
    var c = Model.Customer;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">
        <i class="bx bx-arrow-back me-1"></i>Back to Customer Directory
    </a>
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1">@c.Name</h4>
            <small class="text-muted">Account Registered: @c.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm d-flex align-items-center">
                <i class="bx bx-edit me-1"></i>Edit Profile
            </a>
            <a asp-controller="Ticket" asp-action="Create" asp-route-customerId="@c.Id" class="btn btn-primary btn-sm d-flex align-items-center">
                <i class="bx bx-plus me-1"></i>Create Ticket
            </a>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Contact Info Card -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header pb-0">
                <h5 class="card-title mb-0 fw-semibold d-flex align-items-center">
                    <i class="bx bx-id-card text-primary me-2 fs-5"></i>Profile Details
                </h5>
            </div>
            <div class="card-body pt-3">
                <div class="d-flex align-items-center mb-4">
                    <div class="avatar avatar-md me-3">
                        <span class="avatar-initial rounded-circle bg-label-primary fs-4">
                            @(c.Name.Length > 0 ? c.Name[0].ToString().ToUpper() : "C")
                        </span>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-semibold">@c.Name</h6>
                        <small class="text-muted">@(string.IsNullOrEmpty(c.Company) ? "Individual Client" : c.Company)</small>
                    </div>
                </div>

                <ul class="list-unstyled mb-0 d-flex flex-column gap-3 small">
                    <li>
                        <div class="text-muted">Email Address</div>
                        <div class="fw-semibold">
                            <a href="mailto:@c.Email" class="text-primary d-flex align-items-center">
                                <i class="bx bx-envelope me-1"></i>@c.Email
                            </a>
                        </div>
                    </li>
                    <li>
                        <div class="text-muted">Phone Number</div>
                        <div class="fw-semibold">
                            @(string.IsNullOrEmpty(c.Phone) ? "—" : c.Phone)
                        </div>
                    </li>
                    <li>
                        <div class="text-muted">Company / Organization</div>
                        <div class="fw-semibold">
                            @(string.IsNullOrEmpty(c.Company) ? "—" : c.Company)
                        </div>
                    </li>
                    <li>
                        <div class="text-muted">Last Updated</div>
                        <div class="fw-semibold text-muted">
                            @c.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Ticket History Card -->
    <div class="col-md-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header d-flex align-items-center justify-content-between pb-0">
                <h5 class="card-title mb-0 fw-semibold d-flex align-items-center">
                    <i class="bx bx-support text-primary me-2 fs-5"></i>Support Ticket History
                </h5>
                <span class="badge bg-label-primary">@c.Tickets.Count Tickets</span>
            </div>
            <div class="table-responsive text-nowrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Ticket Code</th>
                            <th>Subject</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Assignee</th>
                            <th>SLA Deadline</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        @if (c.Tickets.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bx bx-folder-open display-6 d-block mb-1 text-secondary"></i>
                                    No support tickets registered for this customer.
                                </td>
                            </tr>
                        }
                        @foreach (var t in c.Tickets)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Ticket" asp-action="Detail" asp-route-id="@t.Id" class="fw-bold font-monospace text-primary">
                                        @t.TicketCode
                                    </a>
                                </td>
                                <td>
                                    <span class="d-inline-block text-truncate" style="max-width: 220px;" title="@t.Subject">
                                        @t.Subject
                                    </span>
                                </td>
                                <td>
                                    @switch (t.Priority)
                                    {
                                        case TicketPriority.Critical:
                                            <span class="badge bg-label-danger text-uppercase">Critical</span>
                                            break;
                                        case TicketPriority.High:
                                            <span class="badge bg-label-warning text-uppercase">High</span>
                                            break;
                                        case TicketPriority.Medium:
                                            <span class="badge bg-label-info text-uppercase">Medium</span>
                                            break;
                                        default:
                                            <span class="badge bg-label-secondary text-uppercase">Low</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @switch (t.Status)
                                    {
                                        case TicketStatus.New:
                                            <span class="badge bg-label-primary text-uppercase">New</span>
                                            break;
                                        case TicketStatus.Assigned:
                                            <span class="badge bg-label-info text-uppercase">Assigned</span>
                                            break;
                                        case TicketStatus.InProgress:
                                            <span class="badge bg-label-warning text-uppercase">In Progress</span>
                                            break;
                                        case TicketStatus.Resolved:
                                            <span class="badge bg-label-success text-uppercase">Resolved</span>
                                            break;
                                        case TicketStatus.Closed:
                                            <span class="badge bg-label-secondary text-uppercase">Closed</span>
                                            break;
                                        case TicketStatus.Reopened:
                                            <span class="badge bg-label-danger text-uppercase">Reopened</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @(t.AssignedToName ?? "Unassigned")
                                </td>
                                <td>
                                    <div class="small @(t.IsOverdue ? "text-danger fw-bold" : "text-muted")">
                                        @t.DueAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                        @if (t.IsOverdue)
                                        {
                                            <span class="badge bg-danger ms-1">Overdue</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
