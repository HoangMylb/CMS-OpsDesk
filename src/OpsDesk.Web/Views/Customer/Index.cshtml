@model OpsDesk.Web.ViewModels.Customer.CustomerListViewModel
@using OpsDesk.Core.Authorization
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold py-1 mb-0">Customer Directory</h4>
        <p class="text-muted mb-0">Directory of customer accounts, contact details, and open support tickets.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center">
        <i class="bx bx-user-plus me-1"></i>Add Customer
    </a>
</div>

<!-- Search Card -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center" data-ajax-form data-ajax-target="customer-table-container">
            <div class="col-md-9">
                <div class="input-group input-group-merge">
                    <span class="input-group-text"><i class="bx bx-search"></i></span>
                    <input type="search" name="search" value="@Model.Search" class="form-control" 
                           placeholder="Search by customer name, email, company, or phone (live search)..." autocomplete="off" />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1 d-flex align-items-center justify-content-center">
                    <i class="bx bx-search me-1"></i>Search
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Customer Table Container (AJAX Partial Target) -->
<div id="customer-table-container" style="transition: opacity 0.15s ease;">
    @await Html.PartialAsync("_CustomerTable", Model)
</div>
