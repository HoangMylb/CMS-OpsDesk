@model OpsDesk.Web.ViewModels.Customer.CustomerListViewModel
@using OpsDesk.Core.Authorization
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold py-1 mb-0">Customer Directory</h4>
        <p class="text-muted mb-0">Directory of customer accounts, contact details, and open support tickets.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center">
        <i class="bx bx-user-plus me-1"></i>Add Customer
    </a>
</div>

<!-- Search Card -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group input-group-merge">
                    <span class="input-group-text"><i class="bx bx-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" 
                           placeholder="Search by customer name, email, company, or phone..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1 d-flex align-items-center justify-content-center">
                    <i class="bx bx-search me-1"></i>Search
                </button>
                @if (!string.IsNullOrEmpty(Model.Search))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Customer Table Card -->
<div class="card shadow-sm border-0">
    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Customer Name</th>
                    <th>Company</th>
                    <th>Contact Info</th>
                    <th class="text-center">Open Tickets</th>
                    <th class="text-center">Total Tickets</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bx bx-user-x display-4 d-block mb-2 text-secondary"></i>
                            No customer accounts found.
                        </td>
                    </tr>
                }
                @foreach (var customer in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="avatar avatar-sm me-3">
                                    <span class="avatar-initial rounded-circle bg-label-primary">
                                        @(customer.Name.Length > 0 ? customer.Name[0].ToString().ToUpper() : "C")
                                    </span>
                                </div>
                                <div>
                                    <a asp-action="Detail" asp-route-id="@customer.Id" class="fw-semibold text-primary d-block">
                                        @customer.Name
                                    </a>
                                    <small class="text-muted">@customer.Email</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(customer.Company))
                            {
                                <span class="badge bg-label-secondary">@customer.Company</span>
                            }
                            else
                            {
                                <span class="text-muted small fst-italic">—</span>
                            }
                        </td>
                        <td>
                            <div class="small">
                                @if (!string.IsNullOrEmpty(customer.Phone))
                                {
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="bx bx-phone me-1"></i>@customer.Phone
                                    </div>
                                }
                                <div class="d-flex align-items-center text-muted">
                                    <i class="bx bx-envelope me-1"></i>@customer.Email
                                </div>
                            </div>
                        </td>
                        <td class="text-center">
                            @if (customer.OpenTicketsCount > 0)
                            {
                                <span class="badge bg-label-warning fw-bold">@customer.OpenTicketsCount</span>
                            }
                            else
                            {
                                <span class="text-muted small">0</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge bg-label-primary">@customer.TotalTicketsCount</span>
                        </td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                    <i class="bx bx-dots-vertical-rounded"></i>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <a class="dropdown-item" asp-action="Detail" asp-route-id="@customer.Id">
                                        <i class="bx bx-show me-1"></i>View Profile
                                    </a>
                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@customer.Id">
                                        <i class="bx bx-edit me-1"></i>Edit
                                    </a>
                                    <a class="dropdown-item" asp-controller="Ticket" asp-action="Create" asp-route-customerId="@customer.Id">
                                        <i class="bx bx-plus-circle me-1"></i>Create Ticket
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="text-muted small">
                Showing page @Model.Page of @Model.TotalPages (Total @Model.TotalCount customers)
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search">
                            <i class="bx bx-chevron-left"></i>
                        </a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search">@p</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search">
                            <i class="bx bx-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
