@model OpsDesk.Web.ViewModels.Ticket.TicketListViewModel
@using OpsDesk.Core.Enums
@{
    ViewData["Title"] = "Support Tickets";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold py-1 mb-0">Support Tickets</h4>
        <p class="text-muted mb-0">
            @(Model.CanViewAll ? "Centralized ticketing desk with multi-tier SLA commitments and workflows." : "Your assigned support queue.")
        </p>
    </div>
    @if (Model.CanCreate)
    {
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center">
            <i class="bx bx-plus me-1"></i>Create Ticket
        </a>
    }
</div>

<!-- Filters Card -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end" data-ajax-form data-ajax-target="ticket-table-container">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Search Keywords</label>
                <div class="input-group input-group-merge">
                    <span class="input-group-text"><i class="bx bx-search"></i></span>
                    <input type="search" name="search" value="@Model.Search" class="form-control" 
                           placeholder="Code, subject, customer..." autocomplete="off" />
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<TicketStatus>()">
                    <option value="">-- All Statuses --</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold">Priority</label>
                <select name="priority" class="form-select" asp-items="Html.GetEnumSelectList<TicketPriority>()">
                    <option value="">-- All Priorities --</option>
                </select>
            </div>

            @if (Model.CanViewAll)
            {
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Assignee</label>
                    <select name="assignedToUserId" class="form-select" asp-items="Model.AgentOptions"></select>
                </div>
            }

            <div class="col-md-2">
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" name="overdueOnly" value="true" id="overdueOnly" 
                           @(Model.OverdueOnly == true ? "checked" : "") />
                    <label class="form-check-label text-danger fw-semibold" for="overdueOnly">
                        <i class="bx bx-alarm-exclamation me-1"></i>Overdue SLA
                    </label>
                </div>
            </div>

            <div class="col-md-1 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100" title="Filter">
                    <i class="bx bx-filter-alt"></i>
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset filter">
                    <i class="bx bx-reset"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div id="ticket-table-container">
    <partial name="_TicketTable" model="Model" />
</div>

