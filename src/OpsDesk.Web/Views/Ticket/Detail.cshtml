@model OpsDesk.Web.ViewModels.Ticket.TicketDetailViewModel
@using OpsDesk.Core.Enums
@{
    ViewData["Title"] = $"Ticket {Model.Ticket.TicketCode}: {Model.Ticket.Subject}";
    var t = Model.Ticket;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-link text-decoration-none p-0 mb-2">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách tickets
    </a>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="font-monospace fs-5 fw-bold text-primary">@t.TicketCode</span>
                @switch (t.Status)
                {
                    case TicketStatus.New:
                        <span class="badge bg-primary fs-6">Mới</span>
                        break;
                    case TicketStatus.Assigned:
                        <span class="badge bg-info text-dark fs-6">Đã phân công</span>
                        break;
                    case TicketStatus.InProgress:
                        <span class="badge bg-warning text-dark fs-6">Đang xử lý</span>
                        break;
                    case TicketStatus.Resolved:
                        <span class="badge bg-success fs-6">Đã giải quyết</span>
                        break;
                    case TicketStatus.Closed:
                        <span class="badge bg-secondary fs-6">Đã đóng</span>
                        break;
                    case TicketStatus.Reopened:
                        <span class="badge bg-danger fs-6">Mở lại</span>
                        break;
                }
                @switch (t.Priority)
                {
                    case TicketPriority.Critical:
                        <span class="badge bg-danger">Khẩn cấp (4h SLA)</span>
                        break;
                    case TicketPriority.High:
                        <span class="badge bg-warning text-dark">Cao (24h SLA)</span>
                        break;
                    case TicketPriority.Medium:
                        <span class="badge bg-info text-dark">Trung bình (48h SLA)</span>
                        break;
                    default:
                        <span class="badge bg-light text-secondary border">Thấp (72h SLA)</span>
                        break;
                }
                @if (t.IsOverdue)
                {
                    <span class="badge bg-danger animate__animated animate__pulse animate__infinite">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>QUÁ HẠN SLA
                    </span>
                }
            </div>
            <h1 class="h4 fw-bold mb-0">@t.Subject</h1>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Cột trái: Nội dung chính & Lịch sử -->
    <div class="col-lg-8">
        <!-- Chi tiết mô tả -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent border-bottom py-3">
                <h2 class="h6 fw-bold mb-0">Nội dung yêu cầu</h2>
            </div>
            <div class="card-body">
                <div class="p-3 bg-light rounded" style="white-space: pre-wrap;">@t.Description</div>
            </div>
        </div>

        <!-- Lịch sử chuyển trạng thái -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent border-bottom py-3 d-flex align-items-center justify-content-between">
                <h2 class="h6 fw-bold mb-0">Lịch sử trạng thái</h2>
                <span class="badge bg-secondary-subtle text-secondary">@t.StatusHistory.Count bản ghi</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Thời gian</th>
                                <th>Chuyển từ → Đến</th>
                                <th>Người thực hiện</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in t.StatusHistory)
                            {
                                <tr>
                                    <td class="small text-muted">@h.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge bg-light text-secondary border">@h.FromStatus</span>
                                        <i class="bi bi-arrow-right mx-1 text-muted small"></i>
                                        <span class="badge bg-primary-subtle text-primary">@h.ToStatus</span>
                                    </td>
                                    <td class="small fw-semibold">@h.ChangedByName</td>
                                    <td class="small text-muted">@(h.Notes ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Lịch sử phân công nhân viên -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent border-bottom py-3 d-flex align-items-center justify-content-between">
                <h2 class="h6 fw-bold mb-0">Lịch sử phân công (Assignment History)</h2>
                <span class="badge bg-secondary-subtle text-secondary">@t.AssignmentHistory.Count bản ghi</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Thời gian</th>
                                <th>Trước đó</th>
                                <th>Phân công cho</th>
                                <th>Người thực hiện</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (t.AssignmentHistory.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-3 text-muted small">Chưa có lịch sử phân công</td>
                                </tr>
                            }
                            @foreach (var a in t.AssignmentHistory)
                            {
                                <tr>
                                    <td class="small text-muted">@a.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="small">@(a.PreviousAssigneeName ?? "Chưa phân công")</td>
                                    <td class="small fw-semibold text-primary">@(a.NewAssigneeName ?? "Gỡ phân công")</td>
                                    <td class="small text-muted">@a.ChangedByName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Thông tin metadata & Phân công -->
    <div class="col-lg-4">
        <!-- Card Phân công nhân viên (Phase 9) -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent border-bottom py-3">
                <h2 class="h6 fw-bold mb-0">
                    <i class="bi bi-person-badge me-1"></i>Phân công xử lý
                </h2>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="text-muted small">Người đang phụ trách:</div>
                    <div class="fw-bold fs-6 mt-1">
                        @if (!string.IsNullOrEmpty(t.AssignedToName))
                        {
                            <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>@t.AssignedToName</span>
                        }
                        else
                        {
                            <span class="text-secondary"><i class="bi bi-dash-circle me-1"></i>Chưa được phân công</span>
                        }
                    </div>
                </div>

                @if (Model.CanAssign)
                {
                    <form asp-action="Assign" method="post">
                        <input type="hidden" name="TicketId" value="@t.Id" />
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Chọn nhân viên phụ trách</label>
                            <select name="AssigneeId" class="form-select form-select-sm" asp-items="Model.ActiveAgentOptions"></select>
                            <div class="form-text small">Hệ thống chỉ cho phép phân công cho nhân viên đang hoạt động (Active).</div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-person-check me-1"></i>Cập nhật phân công
                        </button>
                    </form>
                }
                else
                {
                    <p class="text-muted small mb-0 fst-italic">
                        Bạn không có quyền phân công lại ticket này.
                    </p>
                }
            </div>
        </div>

        <!-- Card Thông tin SLA & Thời gian -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent border-bottom py-3">
                <h2 class="h6 fw-bold mb-0">
                    <i class="bi bi-clock me-1"></i>Tiến độ & Cam kết SLA
                </h2>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0 d-flex flex-column gap-3 small">
                    <li>
                        <div class="text-muted">Hạn cam kết xử lý (Due At):</div>
                        <div class="fw-bold @(t.IsOverdue ? "text-danger" : "text-dark")">
                            @t.DueAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            @if (t.IsOverdue)
                            {
                                <span class="badge bg-danger ms-1">Đã quá hạn</span>
                            }
                        </div>
                    </li>
                    <li>
                        <div class="text-muted">Thời điểm khởi tạo:</div>
                        <div class="fw-semibold">@t.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    </li>
                    <li>
                        <div class="text-muted">Người tạo ticket:</div>
                        <div class="fw-semibold">@t.CreatedByName</div>
                    </li>
                    @if (t.ResolvedAt.HasValue)
                    {
                        <li>
                            <div class="text-muted">Thời điểm giải quyết:</div>
                            <div class="fw-semibold text-success">@t.ResolvedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        </li>
                    }
                    @if (t.ClosedAt.HasValue)
                    {
                        <li>
                            <div class="text-muted">Thời điểm đóng:</div>
                            <div class="fw-semibold text-secondary">@t.ClosedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Card Khách hàng -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent border-bottom py-3">
                <h2 class="h6 fw-bold mb-0">
                    <i class="bi bi-building me-1"></i>Thông tin Khách hàng
                </h2>
            </div>
            <div class="card-body small">
                <div class="fw-bold fs-6 mb-1">
                    <a asp-controller="Customer" asp-action="Detail" asp-route-id="@t.CustomerId" class="text-decoration-none">
                        @t.CustomerName
                    </a>
                </div>
                <div class="text-muted mb-2">
                    <i class="bi bi-envelope me-1"></i>@t.CustomerEmail
                </div>
                <a asp-controller="Customer" asp-action="Detail" asp-route-id="@t.CustomerId" class="btn btn-outline-secondary btn-sm w-100">
                    Xem hồ sơ khách hàng
                </a>
            </div>
        </div>
    </div>
</div>
