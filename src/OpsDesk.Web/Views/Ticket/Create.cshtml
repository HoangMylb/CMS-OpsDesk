@model OpsDesk.Web.ViewModels.Ticket.CreateTicketViewModel
@using OpsDesk.Core.Enums
@{
    ViewData["Title"] = "Tạo phiếu hỗ trợ mới";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent border-0 pt-4 pb-0">
                <a asp-action="Index" class="btn btn-link text-decoration-none p-0 mb-2">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
                </a>
                <h1 class="h5 fw-bold mb-1">Tạo phiếu hỗ trợ mới (Ticket)</h1>
                <p class="text-muted small mb-0">Hệ thống sẽ tự động cấp mã định danh và tính hạn xử lý (SLA) theo mức độ ưu tiên</p>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="CustomerId" class="form-label fw-semibold"></label>
                        <select asp-for="CustomerId" class="form-select" asp-items="Model.CustomerOptions" autofocus></select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        <div class="form-text">
                            Chưa có khách hàng trong danh sách? 
                            <a asp-controller="Customer" asp-action="Create" target="_blank" class="text-decoration-none">Thêm khách hàng mới</a>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label fw-semibold"></label>
                        <input asp-for="Subject" class="form-control" placeholder="Ví dụ: Lỗi không xuất được hóa đơn điện tử VAT..." />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Priority" class="form-label fw-semibold"></label>
                        <div class="row g-2">
                            <div class="col-md-3">
                                <div class="form-check p-3 border rounded">
                                    <input class="form-check-input" type="radio" asp-for="Priority" value="@TicketPriority.Low" id="prio_low" />
                                    <label class="form-check-label fw-medium" for="prio_low">
                                        <span class="badge bg-light text-secondary border d-block mb-1">Thấp</span>
                                        <small class="text-muted">Hạn xử lý: 72h</small>
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check p-3 border rounded">
                                    <input class="form-check-input" type="radio" asp-for="Priority" value="@TicketPriority.Medium" id="prio_med" />
                                    <label class="form-check-label fw-medium" for="prio_med">
                                        <span class="badge bg-info text-dark d-block mb-1">Trung bình</span>
                                        <small class="text-muted">Hạn xử lý: 48h</small>
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check p-3 border rounded">
                                    <input class="form-check-input" type="radio" asp-for="Priority" value="@TicketPriority.High" id="prio_high" />
                                    <label class="form-check-label fw-medium" for="prio_high">
                                        <span class="badge bg-warning text-dark d-block mb-1">Cao</span>
                                        <small class="text-muted">Hạn xử lý: 24h</small>
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check p-3 border rounded">
                                    <input class="form-check-input" type="radio" asp-for="Priority" value="@TicketPriority.Critical" id="prio_crit" />
                                    <label class="form-check-label fw-medium" for="prio_crit">
                                        <span class="badge bg-danger d-block mb-1">Khẩn cấp</span>
                                        <small class="text-muted">Hạn xử lý: 4h</small>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <span asp-validation-for="Priority" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="6" 
                                  placeholder="Mô tả các bước tái hiện lỗi, triệu chứng, mã lỗi hiển thị hoặc yêu cầu của khách hàng..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Tạo phiếu hỗ trợ
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
