@model ErrorViewModel
@{
    ViewData["Title"] = Model.ErrorTitle ?? "Error";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 text-center">
        <div class="mb-4">
            @if (Model.StatusCode == 404)
            {
                <i class="bi bi-compass display-1 text-muted"></i>
            }
            else if (Model.StatusCode == 403)
            {
                <i class="bi bi-shield-x display-1 text-danger"></i>
            }
            else
            {
                <i class="bi bi-exclamation-triangle display-1 text-warning"></i>
            }
        </div>

        <h1 class="h3 fw-bold mb-2">@(Model.ErrorTitle ?? "An unexpected error occurred")</h1>
        <p class="text-muted mb-4 lead fs-6">
            @(Model.ErrorDescription ?? "Something went wrong on our end. Please try again later or contact your system administrator.")
        </p>

        @if (Model.ShowRequestId)
        {
            <div class="mb-4">
                <span class="badge bg-light text-secondary border font-monospace py-2 px-3">
                    Correlation ID: @Model.RequestId
                </span>
            </div>
        }

        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-sm">
                <i class="bi bi-house-door me-1"></i>Return to Dashboard
            </a>
            <button type="button" onclick="history.back()" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Go Back
            </button>
        </div>
    </div>
</div>
