<!DOCTYPE html>
<html lang="en" class="light-style customizer-hide" dir="ltr" data-theme="theme-default" data-assets-path="/lib/sneat/" data-template="vertical-menu-template-free">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>@ViewData["Title"] — OpsDesk</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />
    
    <!-- Icons -->
    <link rel="stylesheet" href="~/lib/sneat/vendor/fonts/iconify-icons.css" />
    
    <!-- Core CSS -->
    <link rel="stylesheet" href="~/lib/sneat/vendor/css/core.css" />
    <link rel="stylesheet" href="~/lib/sneat/css/demo.css" />
    <link rel="stylesheet" href="~/lib/sneat/vendor/css/pages/page-auth.css" />
    <link rel="stylesheet" href="~/lib/sneat/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />

    <!-- Helpers -->
    <script src="~/lib/sneat/vendor/js/helpers.js"></script>
    <script src="~/lib/sneat/js/config.js"></script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @RenderBody()

    <!-- Core Scripts -->
    <script src="~/lib/sneat/vendor/libs/jquery/jquery.js"></script>
    <script src="~/lib/sneat/vendor/libs/popper/popper.js"></script>
    <script src="~/lib/sneat/vendor/js/bootstrap.js"></script>
    <script src="~/lib/sneat/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/lib/sneat/vendor/js/menu.js"></script>
    <script src="~/lib/sneat/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
