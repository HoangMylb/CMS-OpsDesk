@model OpsDesk.Web.ViewModels.Account.LoginViewModel
@{
    Layout = "_Layout_Simple";
    ViewData["Title"] = "Sign In";
}

<div class="container-xxl">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner">
            <!-- Register -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <!-- Logo -->
                    <div class="app-brand justify-content-center mb-4">
                        <span class="app-brand-link gap-2">
                            <span class="app-brand-logo demo">
                                <span class="badge bg-primary p-2 rounded-circle">
                                    <i class="bx bx-headphone text-white fs-3"></i>
                                </span>
                            </span>
                            <span class="app-brand-text demo text-body fw-bolder fs-3">OpsDesk</span>
                        </span>
                    </div>
                    <!-- /Logo -->
                    <h4 class="mb-2 text-center fw-bold">Welcome to OpsDesk! 👋</h4>
                    <p class="mb-4 text-center text-muted">Internal Operations & Customer Support Desk</p>

                    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
                    {
                        <div class="alert alert-warning d-flex align-items-center py-2" role="alert">
                            <i class="bx bx-error me-2 fs-5"></i>
                            <div>@ViewBag.ErrorMessage</div>
                        </div>
                    }

                    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="mb-3">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All" class="alert alert-danger py-2 small" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email or Username</label>
                            <div class="input-group input-group-merge">
                                <span class="input-group-text"><i class="bx bx-user"></i></span>
                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="username or email@company.com"
                                       autocomplete="username"
                                       autofocus />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-password-toggle">
                            <div class="d-flex justify-content-between">
                                <label asp-for="Password" class="form-label">Password</label>
                            </div>
                            <div class="input-group input-group-merge">
                                <span class="input-group-text"><i class="bx bx-lock-alt"></i></span>
                                <input asp-for="Password"
                                       class="form-control"
                                       type="password"
                                       placeholder="············"
                                       autocomplete="current-password" />
                                <span class="input-group-text cursor-pointer" id="passwordToggle" onclick="togglePasswordVisibility()"><i class="bx bx-hide" id="passwordIcon"></i></span>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="remember-me" />
                                <label class="form-check-label" for="remember-me"> Remember Me </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <button class="btn btn-primary d-grid w-100 py-2 fw-semibold" type="submit">
                                <span class="d-flex align-items-center justify-content-center">
                                    <i class="bx bx-log-in me-2"></i>Sign In
                                </span>
                            </button>
                        </div>
                    </form>

                </div>
            </div>
            <!-- /Register -->
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility() {
            var input = document.getElementById('Password');
            var icon = document.getElementById('passwordIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bx-hide');
                icon.classList.add('bx-show');
            } else {
                input.type = 'password';
                icon.classList.remove('bx-show');
                icon.classList.add('bx-hide');
            }
        }
    </script>
}
