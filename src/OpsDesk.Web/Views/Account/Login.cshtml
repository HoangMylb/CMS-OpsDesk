@model OpsDesk.Web.ViewModels.Account.LoginViewModel
@{
    Layout = null; // Trang login không dùng layout chung (không có navbar)
    ViewData["Title"] = "Đăng nhập";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập — OpsDesk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<div class="login-wrapper">
    <div class="login-card card p-4 p-md-5">

        <!-- Logo & Tiêu đề -->
        <div class="text-center mb-4">
            <div class="login-logo mb-3">
                <i class="bi bi-headset"></i>
            </div>
            <h1 class="h4 fw-bold text-dark mb-1">OpsDesk</h1>
            <p class="text-muted small">Hệ thống quản lý hỗ trợ nội bộ</p>
        </div>

        <!-- Thông báo lỗi từ ActiveUserFilter (tài khoản bị vô hiệu hóa...) -->
        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
        {
            <div class="alert alert-warning py-2">
                <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
            </div>
        }

        <!-- Form đăng nhập -->
        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            @Html.AntiForgeryToken()

            <!-- Tổng hợp lỗi validation -->
            <div asp-validation-summary="All" class="alert alert-danger py-2 small" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-envelope text-muted"></i>
                    </span>
                    <input asp-for="Email"
                           class="form-control border-start-0 ps-0"
                           placeholder="email@congty.com"
                           autocomplete="username"
                           autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-lock text-muted"></i>
                    </span>
                    <input asp-for="Password"
                           class="form-control border-start-0 ps-0"
                           placeholder="••••••••"
                           autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small"></label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">
                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
            </button>
        </form>

        <!-- Demo accounts info — chỉ hiện trong development -->
        <div class="mt-4 pt-3 border-top">
            <p class="text-muted small text-center mb-2">
                <i class="bi bi-info-circle me-1"></i>Tài khoản demo
            </p>
            <div class="small text-muted">
                <div class="d-flex justify-content-between py-1">
                    <span>Admin:</span>
                    <code>admin&#64;opsdesk.local / Admin@123456</code>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Manager:</span>
                    <code>manager&#64;opsdesk.local / Manager@123456</code>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Agent:</span>
                    <code>agent1&#64;opsdesk.local / Agent@123456</code>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
