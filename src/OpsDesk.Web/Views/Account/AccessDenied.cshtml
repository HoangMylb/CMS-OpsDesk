@{
    ViewData["Title"] = "Access Denied";
}

<div class="container-xxl py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card text-center p-4 shadow-sm border-0">
                <div class="card-body">
                    <div class="avatar avatar-xl bg-label-danger mx-auto mb-4" style="width: 80px; height: 80px;">
                        <i class="bx bx-shield-x fs-1 d-flex align-items-center justify-content-center h-100"></i>
                    </div>

                    <h2 class="h3 fw-bold text-danger mb-2">Access Denied (403)</h2>
                    <p class="text-muted mb-4">
                        You do not have the required permissions to access this page or resource.<br />
                        If you believe this is an error, please contact your administrator.
                    </p>

                    <div class="d-flex gap-2 justify-content-center">
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                            <i class="bx bx-home-circle me-1"></i>Back to Dashboard
                        </a>
                        <button onclick="history.back()" class="btn btn-outline-secondary">
                            <i class="bx bx-arrow-back me-1"></i>Go Back
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
