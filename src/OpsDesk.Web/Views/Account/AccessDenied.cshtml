@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">

        <div class="mb-4">
            <i class="bi bi-shield-x text-danger" style="font-size: 4rem;"></i>
        </div>

        <h1 class="h3 fw-bold text-danger mb-2">Không có quyền truy cập</h1>

        <p class="text-muted mb-4">
            Bạn không có quyền thực hiện thao tác này.<br />
            Nếu bạn cho rằng đây là nhầm lẫn, vui lòng liên hệ Admin.
        </p>

        <div class="d-flex gap-2 justify-content-center">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house me-1"></i>Về Dashboard
            </a>
            <button onclick="history.back()" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Quay lại
            </button>
        </div>

    </div>
</div>
