@model OpsDesk.Web.ViewModels.Employee.EmployeeListViewModel
@using OpsDesk.Core.Authorization
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold py-1 mb-0">Staff & Employee Directory</h4>
        <p class="text-muted mb-0">Manage employee accounts, department allocations, and access status.</p>
    </div>
    @if (User.HasClaim("Permission", Permissions.Employee.Create))
    {
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center">
            <i class="bx bx-user-plus me-1"></i>Add Employee
        </a>
    }
</div>

<!-- Filters Card -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end" data-ajax-form data-ajax-target="employee-table-container">
            <div class="col-md-5">
                <label class="form-label small fw-semibold">Search Staff</label>
                <div class="input-group input-group-merge">
                    <span class="input-group-text"><i class="bx bx-search"></i></span>
                    <input name="search" type="search" value="@Model.Search" class="form-control"
                           placeholder="Full name or email address (live search)..." autocomplete="off" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Account Status</label>
                <select name="isActive" class="form-select">
                    <option value="">-- All Accounts --</option>
                    <option value="true" selected="@(Model.IsActive == true)">Active Accounts</option>
                    <option value="false" selected="@(Model.IsActive == false)">Deactivated Accounts</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center">
                    <i class="bx bx-filter-alt me-1"></i>Filter
                </button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center">
                    <i class="bx bx-reset me-1"></i>Reset
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Employee Table Container (AJAX Partial Target) -->
<div id="employee-table-container" style="transition: opacity 0.15s ease;">
    @await Html.PartialAsync("_EmployeeTable", Model)
</div>
