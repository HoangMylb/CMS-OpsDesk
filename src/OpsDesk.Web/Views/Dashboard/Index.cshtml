@model OpsDesk.Core.Services.DashboardViewModelData
@using OpsDesk.Core.Enums
@{
    ViewData["Title"] = "Dashboard";
    var kpi = Model.Kpi;
}

<div class="row">
    <div class="col-12 mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h4 class="fw-bold py-1 mb-0">Operations Dashboard</h4>
                <p class="text-muted mb-0">
                    @(Model.IsAdminOrManager ? "Real-time overview of support workload, active queues, and SLA performance." : "Your personal assigned tickets and queue status.")
                </p>
            </div>
            @if (User.HasClaim("Permission", "Ticket.Create"))
            {
                <a asp-controller="Ticket" asp-action="Create" class="btn btn-primary d-flex align-items-center">
                    <i class="bx bx-plus me-1"></i>New Support Ticket
                </a>
            }
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row">
    <!-- Total Tickets -->
    <div class="col-lg-2 col-md-4 col-6 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body pb-3">
                <div class="d-flex align-items-center mb-2">
                    <div class="avatar flex-shrink-0 me-2">
                        <span class="avatar-initial rounded bg-label-primary"><i class="bx bx-folder-open"></i></span>
                    </div>
                    <span class="fw-semibold d-block text-muted small text-uppercase">Total</span>
                </div>
                <h3 class="card-title mb-1 text-dark">@kpi.TotalTickets</h3>
                <small class="text-muted">Tickets in system</small>
            </div>
        </div>
    </div>

    <!-- Open Tickets -->
    <div class="col-lg-2 col-md-4 col-6 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body pb-3">
                <div class="d-flex align-items-center mb-2">
                    <div class="avatar flex-shrink-0 me-2">
                        <span class="avatar-initial rounded bg-label-info"><i class="bx bx-support"></i></span>
                    </div>
                    <span class="fw-semibold d-block text-muted small text-uppercase">Open</span>
                </div>
                <h3 class="card-title mb-1 text-info">@kpi.OpenTickets</h3>
                <small class="text-info">Unresolved queue</small>
            </div>
        </div>
    </div>

    <!-- In Progress -->
    <div class="col-lg-3 col-md-4 col-6 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body pb-3">
                <div class="d-flex align-items-center mb-2">
                    <div class="avatar flex-shrink-0 me-2">
                        <span class="avatar-initial rounded bg-label-warning"><i class="bx bx-time-five"></i></span>
                    </div>
                    <span class="fw-semibold d-block text-muted small text-uppercase">In Progress</span>
                </div>
                <h3 class="card-title mb-1 text-warning">@kpi.InProgressTickets</h3>
                <small class="text-muted">Under active resolution</small>
            </div>
        </div>
    </div>

    <!-- Overdue SLA -->
    <div class="col-lg-3 col-md-6 col-6 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body pb-3">
                <div class="d-flex align-items-center mb-2">
                    <div class="avatar flex-shrink-0 me-2">
                        <span class="avatar-initial rounded bg-label-danger"><i class="bx bx-error-circle"></i></span>
                    </div>
                    <span class="fw-semibold d-block text-danger small text-uppercase">Overdue SLA</span>
                </div>
                <h3 class="card-title mb-1 text-danger">@kpi.OverdueTickets</h3>
                <small class="text-danger fw-semibold">Action required immediately</small>
            </div>
        </div>
    </div>

    <!-- Resolved Today -->
    <div class="col-lg-2 col-md-6 col-12 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body pb-3">
                <div class="d-flex align-items-center mb-2">
                    <div class="avatar flex-shrink-0 me-2">
                        <span class="avatar-initial rounded bg-label-success"><i class="bx bx-check-double"></i></span>
                    </div>
                    <span class="fw-semibold d-block text-success small text-uppercase">Resolved Today</span>
                </div>
                <h3 class="card-title mb-1 text-success">@kpi.ResolvedTodayCount</h3>
                <small class="text-muted">Completed today</small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Priority SLA Distribution -->
    <div class="col-md-6 col-lg-6 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header d-flex align-items-center justify-content-between pb-0">
                <div class="card-title mb-0">
                    <h5 class="m-0 me-2 fw-semibold">Distribution by Priority (SLA)</h5>
                    <small class="text-muted">Active open queue prioritization</small>
                </div>
            </div>
            <div class="card-body pt-3">
                <div class="d-flex flex-column gap-3">
                    @foreach (var p in Model.PriorityDistribution)
                    {
                        var labelClass = p.Priority switch
                        {
                            TicketPriority.Critical => "bg-label-danger text-danger",
                            TicketPriority.High => "bg-label-warning text-warning",
                            TicketPriority.Medium => "bg-label-info text-info",
                            _ => "bg-label-secondary text-secondary"
                        };
                        var barClass = p.Priority switch
                        {
                            TicketPriority.Critical => "bg-danger",
                            TicketPriority.High => "bg-warning",
                            TicketPriority.Medium => "bg-info",
                            _ => "bg-secondary"
                        };
                        var percentage = kpi.OpenTickets > 0 ? (int)Math.Round((double)p.Count / kpi.OpenTickets * 100) : 0;
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge @labelClass text-uppercase fw-semibold">@p.PriorityName</span>
                                <span class="small fw-semibold">@p.Count tickets (@percentage%)</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar @barClass" role="progressbar" style="width: @percentage%" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Status Distribution -->
    <div class="col-md-6 col-lg-6 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header d-flex align-items-center justify-content-between pb-0">
                <div class="card-title mb-0">
                    <h5 class="m-0 me-2 fw-semibold">Distribution by Lifecycle Status</h5>
                    <small class="text-muted">State machine breakdown</small>
                </div>
            </div>
            <div class="card-body pt-3">
                <div class="d-flex flex-column gap-3">
                    @foreach (var s in Model.StatusDistribution)
                    {
                        var labelClass = s.Status switch
                        {
                            TicketStatus.New => "bg-label-primary text-primary",
                            TicketStatus.Assigned => "bg-label-info text-info",
                            TicketStatus.InProgress => "bg-label-warning text-warning",
                            TicketStatus.Resolved => "bg-label-success text-success",
                            TicketStatus.Closed => "bg-label-secondary text-secondary",
                            _ => "bg-label-danger text-danger"
                        };
                        var barClass = s.Status switch
                        {
                            TicketStatus.New => "bg-primary",
                            TicketStatus.Assigned => "bg-info",
                            TicketStatus.InProgress => "bg-warning",
                            TicketStatus.Resolved => "bg-success",
                            TicketStatus.Closed => "bg-secondary",
                            _ => "bg-danger"
                        };
                        var percentage = kpi.TotalTickets > 0 ? (int)Math.Round((double)s.Count / kpi.TotalTickets * 100) : 0;
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge @labelClass text-uppercase fw-semibold">@s.StatusName</span>
                                <span class="small fw-semibold">@s.Count tickets (@percentage%)</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar @barClass" role="progressbar" style="width: @percentage%" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.IsAdminOrManager && Model.AgentWorkloads.Count > 0)
{
    <!-- Agent Workload Table -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="card-title mb-0 fw-semibold">Agent Workload & Capacity</h5>
            <span class="badge bg-label-primary">@Model.AgentWorkloads.Count Active Staff</span>
        </div>
        <div class="table-responsive text-nowrap">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Agent Name</th>
                        <th class="text-center">Assigned</th>
                        <th class="text-center">In Progress</th>
                        <th class="text-center">Overdue</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    @foreach (var a in Model.AgentWorkloads)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar avatar-sm me-2">
                                        <span class="avatar-initial rounded-circle bg-label-primary">
                                            @(a.AgentName.Length > 0 ? a.AgentName[0].ToString().ToUpper() : "A")
                                        </span>
                                    </div>
                                    <span class="fw-semibold">@a.AgentName</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-label-secondary">@a.AssignedCount</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-label-warning">@a.InProgressCount</span>
                            </td>
                            <td class="text-center">
                                @if (a.OverdueCount > 0)
                                {
                                    <span class="badge bg-label-danger fw-bold">@a.OverdueCount</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Ticket" asp-action="Index" asp-route-assignedToUserId="@a.AgentId" class="btn btn-sm btn-outline-primary">
                                    <i class="bx bx-show me-1"></i>View Queue
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Urgent Overdue Tickets -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header d-flex align-items-center justify-content-between">
        <div>
            <h5 class="card-title mb-0 text-danger fw-semibold d-flex align-items-center">
                <i class="bx bx-alarm-exclamation me-2 fs-4"></i>Urgent Overdue Tickets
            </h5>
            <small class="text-muted">Tickets that breached initial resolution commitments</small>
        </div>
        <a asp-controller="Ticket" asp-action="Index" asp-route-overdueOnly="true" class="btn btn-sm btn-outline-danger">
            View All Overdue
        </a>
    </div>
    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Ticket Code</th>
                    <th>Subject</th>
                    <th>Customer</th>
                    <th>Priority</th>
                    <th>Assignee</th>
                    <th>SLA Due Date</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model.TopOverdueTickets.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-success">
                            <i class="bx bx-check-circle me-1 fs-5 align-middle"></i>All tickets are currently within SLA commitments!
                        </td>
                    </tr>
                }
                @foreach (var t in Model.TopOverdueTickets)
                {
                    <tr class="table-danger">
                        <td>
                            <a asp-controller="Ticket" asp-action="Detail" asp-route-id="@t.Id" class="fw-bold font-monospace text-danger">
                                @t.TicketCode
                            </a>
                        </td>
                        <td>
                            <span class="text-truncate d-inline-block" style="max-width: 250px;" title="@t.Subject">
                                @t.Subject
                            </span>
                        </td>
                        <td>@t.CustomerName</td>
                        <td><span class="badge bg-danger text-uppercase">@t.Priority</span></td>
                        <td>@(t.AssignedToName ?? "Unassigned")</td>
                        <td class="text-danger fw-bold">@t.DueAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
